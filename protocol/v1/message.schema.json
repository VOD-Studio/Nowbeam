{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nowbeam:protocol:v1:message",
  "title": "Nowbeam v1 WebSocket message",
  "oneOf": [
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?Z$",
      "allOf": [{ "$ref": "#/$defs/text" }]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "\\S" },
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F]" } }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "position": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "$ref": "#/$defs/text", "maxLength": 128 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/text", "maxLength": 1024 }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "durationMs", "positionMs", "rate"],
      "properties": {
        "state": { "enum": ["playing", "paused"] },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "positionMs": { "$ref": "#/$defs/position" },
        "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 4 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "paused" } } },
          "then": { "properties": { "rate": { "const": 0 } } },
          "else": { "properties": { "rate": { "exclusiveMinimum": 0 } } }
        }
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "playerName", "title", "artist", "album", "playback"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "playerName": { "$ref": "#/$defs/text", "maxLength": 128 },
        "title": { "$ref": "#/$defs/text", "maxLength": 512 },
        "artist": {
          "oneOf": [
            { "$ref": "#/$defs/text", "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "album": {
          "oneOf": [
            { "$ref": "#/$defs/text", "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "playback": { "$ref": "#/$defs/playback" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "window", "media"],
      "properties": {
        "application": {
          "oneOf": [{ "$ref": "#/$defs/application" }, { "type": "null" }]
        },
        "window": {
          "oneOf": [{ "$ref": "#/$defs/window" }, { "type": "null" }]
        },
        "media": {
          "oneOf": [{ "$ref": "#/$defs/media" }, { "type": "null" }]
        }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "connectionId", "deviceId", "serverTime",
        "heartbeatIntervalMs", "leaseDurationMs", "maxMessageBytes"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "welcome" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/uuid" },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "heartbeatIntervalMs": { "const": 15000 },
        "leaseDurationMs": { "const": 45000 },
        "maxMessageBytes": { "const": 65536 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "connectionId", "sequence", "observedAt", "sources"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "snapshot" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "connectionId", "sequence", "receivedAt", "expiresAt"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "ack" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "receivedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "connectionId", "sequence", "code"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "error" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "sequence": {
          "oneOf": [{ "$ref": "#/$defs/sequence" }, { "type": "null" }]
        },
        "code": {
          "enum": [
            "invalid_message", "out_of_order", "sequence_conflict",
            "credential_revoked", "session_replaced", "internal_error"
          ]
        }
      }
    }
  }
}
